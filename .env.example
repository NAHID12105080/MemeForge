# Postgres (docker-compose)
POSTGRES_USER=memeforge
POSTGRES_PASSWORD=memeforge
POSTGRES_DB=memeforge
DATABASE_URL=postgresql://memeforge:memeforge@localhost:5433/memeforge

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional — omit a provider's pair to leave it disabled)
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> OAuth Apps
#   Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
